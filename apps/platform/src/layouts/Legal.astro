---
import Base from './Base.astro';

export interface Props {
  title: string;
  description: string;
  updated?: string;
}

const { title, description, updated = '18 Oktober 2026' } = Astro.props;
---

<Base title={`${title} — Pejuang Nafkah`} description={description}>
  <section class="legal-page">
    <div class="legal-inner">
      <div class="eyebrow">Legal · Draf pra-rilis</div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="legal-draft">
        <strong>Catatan:</strong> ini adalah draf yang berlaku untuk halaman pre-alpha. Pembayaran
        belum aktif. Kebijakan final akan ditinjau sebelum toko dibuka. Pertanyaan:{' '}
        <a href="mailto:wniseries@gmail.com">wniseries@gmail.com</a>.
      </div>
      <p class="muted"><small>Terakhir diperbarui: {updated}</small></p>
      <slot />
    </div>
  </section>
</Base>
