<section class="hero" id="atas" aria-labelledby="hero-title">
  <img
    class="hero-poster"
    src="/images/motor-900.webp"
    srcset="/images/motor-900.webp 900w, /images/motor.webp 1600w"
    sizes="100vw"
    alt=""
    width="1600"
    height="1000"
    fetchpriority="high"
    decoding="async"
  />
  <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-grain" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <div class="eyebrow hero-kicker">WNI Series #1 · Pre-alpha · 1 jempol, drama ada-ada aja</div>
      <h1 class="hero-title" id="hero-title">
        <span class="line"><span>Berangkat.</span></span>
        <span class="line"><span>Berjuang.</span></span>
        <span class="line"><span><em>Sampai.</em></span></span>
      </h1>
      <p class="hero-punch">Gitu aja terus setiap hari.</p>
      <p class="hero-tagline"><span>Susahnya nyata,</span> <span>dramanya gratis.</span></p>
      <p class="hero-lede">
        Game satu tangan tentang perjalanan pagi di Jabodetabek. Motor, KRL, atau keduanya —
        dari Bintaro sampai Sudirman. Bukan balapan. Ini perjalanan menuju gajian, kadang
        lewat drama yang nggak masuk jadwal.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#daftar">
          Daftar tunggu
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-ghost" href="#rute">Lihat rute asli</a>
      </div>
      <div class="hero-meta">
        <span>5–15 menit per perjalanan</span>
        <span>Gratis untuk satu rute pilihan</span>
        <span>Tanpa iklan</span>
      </div>
    </div>

    <aside class="hero-aside" aria-label="Contoh kartu perjalanan">
      <div class="live-board" data-tilt>
        <div class="board-top">
          <span>Senin · 05:42 WIB</span>
          <span class="board-live">Live</span>
        </div>
        <div class="board-route">
          <span>JMU</span>
          <span class="arrow-line" aria-hidden="true"></span>
          <span>SUD</span>
        </div>
        <div class="board-stats">
          <div class="board-stat">
            <strong>58 mnt</strong>
            <span>Estimasi</span>
          </div>
          <div class="board-stat">
            <strong>Rp 9.500</strong>
            <span>Ongkos</span>
          </div>
          <div class="board-stat">
            <strong>1×</strong>
            <span>Transfer</span>
          </div>
        </div>
        <div class="board-foot">
          <span>Jurangmangu → Sudirman</span>
          <span class="mode-chip">Motor + KRL</span>
        </div>
      </div>
      <div class="prealpha-note">
        <span aria-hidden="true">◐</span>
        <span>
          <strong>Pre-alpha visual target.</strong> Ini representasi arah visual dan data perjalanan,
          bukan gameplay final. Kami tidak menjanjikan yang belum ada.
        </span>
      </div>
      <p class="hero-mobile-note">Pre-alpha · visual target, belum bisa dimainkan.</p>
    </aside>
  </div>

  <div class="morning-strip" aria-label="Ritme satu pagi">
    <ol data-morning-strip>
      <li><span>05:12</span> alarm</li>
      <li><span>05:40</span> motor</li>
      <li><span>06:15</span> stasiun</li>
      <li><span>08:29</span> kantor</li>
    </ol>
  </div>

  <div class="scroll-cue" aria-hidden="true">Scroll</div>
</section>

<script>
  const canvas = document.querySelector('[data-hero-canvas]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobile = window.matchMedia('(max-width: 760px)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  if (canvas instanceof HTMLCanvasElement && !reduced && !mobile && !saveData) {
    let loaded = false;
    const start = async () => {
      if (loaded) return;
      loaded = true;
      try {
        const { initStreetScene } = await import('../scripts/hero-scene');
        initStreetScene(canvas);
        canvas.classList.add('is-ready');
      } catch {
        // WebGL unavailable or context lost: the poster is the complete fallback.
        canvas.remove();
      }
    };
    // Keep the poster as the LCP-friendly first paint; load the live scene only
    // after the page is useful, or when the visitor interacts.
    window.setTimeout(() => void start(), 4200);
    window.addEventListener('pointerdown', () => void start(), { once: true, passive: true });
    window.addEventListener('scroll', () => void start(), { once: true, passive: true });
    window.addEventListener('keydown', () => void start(), { once: true });
  }
</script>
