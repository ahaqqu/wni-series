---
interface Props {
  quote?: string;
}
const {
  quote = 'Kursi kosong itu mitos. Yang ada cuma kursi yang belum kamu lihat.',
} = Astro.props;
---

<figure class="bang-card" data-reveal>
  <div class="bang-sticker">
    <span class="bang-tape" aria-hidden="true"></span>
    <svg class="bang-face" viewBox="0 0 230 230" role="img" aria-label="Ilustrasi Bang Nafkah, komuter dengan helm dan termos">
      <path d="M27 111c0-48 34-82 84-82 53 0 91 31 91 84 0 52-34 88-91 88-51 0-84-38-84-90Z" fill="#F4EBDD" stroke="#07131D" stroke-width="4" />
      <path d="M55 199c8-35 33-53 61-53 30 0 54 19 62 53" fill="#2A9D8F" stroke="#07131D" stroke-width="4" />
      <path d="M77 151c8 10 22 17 38 17 17 0 31-7 39-18" fill="#E9F5F0" stroke="#07131D" stroke-width="3" />
      <path d="M92 91c0-20 14-35 33-35s33 15 33 35v27c0 22-14 38-33 38s-33-16-33-38V91Z" fill="#C78B52" stroke="#07131D" stroke-width="4" />
      <path d="M82 86c0-28 18-46 44-46 27 0 43 18 43 46v8H82v-8Z" fill="#0B1B2B" stroke="#07131D" stroke-width="4" />
      <path d="M86 69c11-14 25-21 41-21 18 0 32 7 41 21" fill="#132F3C" stroke="#07131D" stroke-width="3" />
      <path d="M92 56h52" stroke="#FFB347" stroke-width="7" stroke-linecap="round" />
      <path d="M108 102c4-4 10-4 14 0M131 102c4-4 10-4 14 0" stroke="#07131D" stroke-width="4" stroke-linecap="round" />
      <path d="M112 124c7 6 17 8 25 2" stroke="#07131D" stroke-width="4" stroke-linecap="round" />
      <path d="M89 121c-4 3-7 8-7 13M160 121c4 3 7 8 7 13" stroke="#07131D" stroke-width="3" stroke-linecap="round" opacity=".5" />
      <path d="M61 176c9 2 18 7 24 14" stroke="#07131D" stroke-width="3" stroke-linecap="round" opacity=".3" />
      <rect x="163" y="160" width="26" height="47" rx="7" fill="#FFB347" stroke="#07131D" stroke-width="4" />
      <path d="M171 160v-8c0-5 4-8 9-8s9 3 9 8v8" stroke="#07131D" stroke-width="4" />
      <path d="M169 176h14M169 187h14" stroke="#07131D" stroke-width="3" stroke-linecap="round" />
      <path d="M47 172c-9 6-14 14-12 23" stroke="#07131D" stroke-width="4" stroke-linecap="round" />
      <circle cx="51" cy="196" r="5" fill="#E33A4E" stroke="#07131D" stroke-width="2" />
    </svg>
    <span class="bang-label">Bang Nafkah</span>
    <span class="bang-role">suara di dalam kepala</span>
  </div>

  <figcaption class="bang-copy">
    <div class="eyebrow">Narator resmi pagi hari</div>
    <blockquote>“{quote}”</blockquote>
    <p>
      Komuter, pekerja, ahli kiasan. Tidak pernah terlambat untuk panik, tapi selalu sempat
      untuk ketawa. Ini orang yang akan menemani kamu menunggu pintu berikutnya.
    </p>
    <span class="bang-sign">— Bang Nafkah, 05:41 WIB</span>
  </figcaption>
</figure>
