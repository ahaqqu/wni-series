---
import BangNafkah from './BangNafkah.astro';
---

<section class="section recognition" id="rasa" aria-labelledby="recognition-title">
  <div class="section-inner">
    <div class="section-head">
      <div data-reveal>
        <div class="eyebrow">Susahnya nyata · rasa-nya bener</div>
        <h2 id="recognition-title">Bukan peta fiksi.<br />Bukan macet karangan.</h2>
      </div>
      <p class="lede" data-reveal data-reveal-delay="1">
        Kami mulai dari hal-hal yang kamu alami sendiri: angkot yang berhenti di mana saja,
        pintu yang tidak menunggu, hujan yang mengubah semua rencana. Lucu setelah lewat.
        Menyebalkan saat terjadi. Kami tidak mengarang capek — kami cuma menambahkan ketawa.
      </p>
    </div>

    <div class="recognition-grid">
      <article class="recognition-card" data-reveal data-tilt>
        <span class="card-index">01 / JALAN</span>
        <span class="card-stamp">RELATE</span>
        <h3>Angkot berhenti di mana saja.</h3>
        <p>Bukan di halte. Bukan pakai lampu sein. Kamu yang harus membaca situasi.</p>
        <div class="card-visual" aria-hidden="true">
          <svg viewBox="0 0 190 170" fill="none">
            <path d="M8 132h174" stroke="rgba(244,235,221,.18)" stroke-width="2" />
            <path d="M24 143h142" stroke="rgba(255,179,71,.42)" stroke-width="2" stroke-dasharray="10 12" />
            <rect x="54" y="54" width="86" height="62" rx="8" fill="#163743" stroke="rgba(244,235,221,.24)" />
            <rect x="68" y="66" width="28" height="20" rx="3" fill="#8fc3d5" opacity=".5" />
            <rect x="104" y="66" width="22" height="20" rx="3" fill="#8fc3d5" opacity=".28" />
            <path d="M54 94h86" stroke="#2A9D8F" stroke-width="5" />
            <circle cx="76" cy="120" r="10" fill="#0B1B2B" stroke="rgba(244,235,221,.4)" />
            <circle cx="120" cy="120" r="10" fill="#0B1B2B" stroke="rgba(244,235,221,.4)" />
            <circle cx="156" cy="86" r="4" fill="#FFB347">
              <animate attributeName="opacity" values="1;.25;1" dur="2.4s" repeatCount="indefinite" />
            </circle>
            <path d="M155 75v-8M168 86h8" stroke="#FFB347" stroke-width="2" opacity=".5" />
          </svg>
        </div>
      </article>

      <article class="recognition-card" data-reveal data-reveal-delay="1" data-tilt>
        <span class="card-index">02 / KRL</span>
        <span class="card-stamp">8 DETIK</span>
        <h3>Pintu KRL nggak nunggu kamu.</h3>
        <p>Delapan detik. Kadang cukup. Kadang kamu cuma bisa lihat kereta pergi.</p>
        <div class="card-visual" aria-hidden="true">
          <svg viewBox="0 0 190 170" fill="none">
            <rect x="42" y="20" width="110" height="130" rx="10" fill="#132F3C" stroke="rgba(244,235,221,.22)" />
            <rect x="58" y="38" width="36" height="66" rx="4" fill="#07131D" stroke="rgba(244,235,221,.18)" />
            <rect x="102" y="38" width="36" height="66" rx="4" fill="#07131D" stroke="rgba(244,235,221,.18)" />
            <path d="M72 38v66M116 38v66" stroke="rgba(255,179,71,.45)" stroke-width="2" />
            <circle cx="96" cy="70" r="3" fill="#FFB347">
              <animate attributeName="opacity" values="1;.2;1" dur="1.8s" repeatCount="indefinite" />
            </circle>
            <path d="M62 118h66" stroke="rgba(244,235,221,.2)" stroke-width="2" />
            <path d="M76 118v8M114 118v8" stroke="#E33A4E" stroke-width="3" />
            <path d="M36 150h126" stroke="rgba(255,179,71,.35)" stroke-width="2" stroke-dasharray="8 10" />
            <path d="M22 40c10 6 10 18 0 24" stroke="rgba(100,216,198,.32)" stroke-width="2" />
            <path d="M168 40c-10 6-10 18 0 24" stroke="rgba(100,216,198,.32)" stroke-width="2" />
          </svg>
        </div>
      </article>

      <article class="recognition-card" data-reveal data-reveal-delay="2" data-tilt>
        <span class="card-index">03 / HUJAN</span>
        <span class="card-stamp">BASAH</span>
        <h3>Hujan bikin semua orang telat.</h3>
        <p>Kamu, angkot, ojol, dan bos kamu. Bedanya, cuma kamu yang basah.</p>
        <div class="card-visual" aria-hidden="true">
          <svg viewBox="0 0 190 170" fill="none">
            <path d="M22 138h146" stroke="rgba(244,235,221,.16)" stroke-width="2" />
            <path d="M48 56c22-20 56-20 78 0" stroke="#77B7C9" stroke-width="3" stroke-linecap="round" />
            <path d="M52 56c8-10 18-16 30-18" stroke="rgba(244,235,221,.4)" stroke-width="2" />
            <path d="M86 146V92c0-12 10-20 22-20s22 8 22 20v54" stroke="#FFB347" stroke-width="3" stroke-linecap="round" />
            <path d="M108 72v58" stroke="rgba(255,179,71,.4)" stroke-width="2" />
            <path d="M98 130h20" stroke="#FFB347" stroke-width="2" />
            <g stroke="#77B7C9" stroke-width="2" stroke-linecap="round" opacity=".65">
              <path d="M38 80l-5 14"><animate attributeName="opacity" values=".2;.9;.2" dur="1.6s" repeatCount="indefinite" /></path>
              <path d="M64 92l-5 14"><animate attributeName="opacity" values=".8;.2;.8" dur="1.9s" repeatCount="indefinite" /></path>
              <path d="M144 76l-5 14"><animate attributeName="opacity" values=".3;.9;.3" dur="1.3s" repeatCount="indefinite" /></path>
              <path d="M160 96l-5 14"><animate attributeName="opacity" values=".9;.2;.9" dur="2.1s" repeatCount="indefinite" /></path>
            </g>
          </svg>
        </div>
      </article>
    </div>

    <BangNafkah />
  </div>
</section>
