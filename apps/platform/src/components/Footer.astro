          <ul>
            <li><a href="/privasi">Privasi</a></li>
            <li><a href="/syarat">Syarat</a></li>
            <li><a href="/refund">Refund</a></li>
            <li><a href="mailto:wniseries@gmail.com">wniseries@gmail.com</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} WNI Series. Dibuat di Jakarta.</span>
      <span>Data peta © OpenStreetMap contributors, ODbL.</span>
      <a href="mailto:wniseries@gmail.com">wniseries@gmail.com</a>
