[Unit]
Description=WNI Series PostgreSQL backup to R2
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=wni-deploy
WorkingDirectory=/srv/wni
EnvironmentFile=/srv/wni/.env
ExecStart=/srv/wni/scripts/backup-postgres.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
