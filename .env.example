# ---------------------------------------------------------------------------
# WNI Series — example environment. Never commit real values.
# Copy to .env for local development. Production uses /srv/wni/.env (mode 600).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:3000
PUBLIC_GAME_URL=http://localhost:4321/play/pejuang-nafkah/
PUBLIC_ASSET_ORIGIN=http://localhost:8787

# Database
DATABASE_URL=postgres://wni:wni@localhost:5432/wni
IP_HASH_SALT=dev-only-salt

# Better Auth
BETTER_AUTH_SECRET=replace-with-32-plus-random-bytes
BETTER_AUTH_URL=http://localhost:3000
SESSION_COOKIE_DOMAIN=localhost

# Google OAuth (server-only secret)
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Email (Resend)
RESEND_API_KEY=re_replace_me
EMAIL_FROM=no-reply@example.com
SUPPORT_EMAIL=wniseries@gmail.com

# Mayar — use sandbox until KYC and production approval
MAYAR_ENV=sandbox
MAYAR_API_KEY=replace-me
MAYAR_PRODUCT_ID_ALL_MAPS=replace-mayar-invoice-product-id
MAYAR_PRODUCT_ID_LIVE=replace-mayar-saas-product-id
MAYAR_TIER_ID_LIVE=replace-mayar-tier-id
MAYAR_WEBHOOK_PATH_SECRET=replace-random-path-secret
MAYAR_RETURN_URL=http://localhost:4321/checkout/return

# Live data (server only)
TOMTOM_API_KEY=replace-me
BMKG_BASE_URL=https://api.bmkg.go.id
OPEN_METEO_API_KEY=
LIVE_PROVIDER_MONTHLY_BUDGET_IDR=3000000

# Play token signing (Ed25519). Generate with scripts/generate-keys.mjs when added.
PLAY_TOKEN_PRIVATE_KEY=
PLAY_TOKEN_PUBLIC_KEY=

# Cloudflare R2 (private backups + paid asset packs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wni-private
R2_PUBLIC_BUCKET=wni-public
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Observability (optional in local)
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Cloudflare / deploy (CI secrets, not client)
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
DEPLOY_ENABLED=false

# Feature flags (server-side kill switches)
FEATURE_PAYMENTS=false
FEATURE_LEADERBOARD=false
FEATURE_LIVE_DATA=false
FEATURE_DAILY_DRAMA=false

# Daily drama (Phase 2D). AUTO_PUBLISH must stay false: the owner approves every pack.
AUTO_PUBLISH_DAILY_DRAMA=false
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_MONTHLY_BUDGET_IDR=1000000
DAILY_DRAMA_CANDIDATE_LIMIT=8
DAILY_DRAMA_SOURCE_ALLOWLIST=
DRAMA_REVIEW_NOTIFY_EMAIL=wniseries@gmail.com
DRAMA_PACK_SIGNING_KEY=
R2_DRAMA_STAGING_PREFIX=drama-staging/
R2_DRAMA_PRODUCTION_PREFIX=drama/
